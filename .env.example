# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NUNCA se sube a git. En producción estas mismas
# variables se definen en Vercel (Settings -> Environment Variables).

# Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (sb_publishable_...). Es pública: va al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). SECRETA: solo servidor, sin prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
